{"created": "2025-10-11T11:17:48.733444+00:00", "modified": "2025-10-11T11:17:48.862578+00:00", "id": 17322891, "conceptrecid": "17322890", "doi": "10.5281/zenodo.17322891", "conceptdoi": "10.5281/zenodo.17322890", "doi_url": "https://doi.org/10.5281/zenodo.17322891", "metadata": {"title": "Reprocessed data for training and benchmarking Deep Amino acid Selection Models", "doi": "10.5281/zenodo.17322891", "publication_date": "2025-10-11", "description": "<p>This consists of reprocessed data from various sources for training and benchmarking. This data is meant to be consumed by the <a href=\"https://github.com/matsengrp/dasm-experiments/\">dasm-experiments</a> repository.</p>\n<p dir=\"auto\"><strong>Benchmark datasets</strong>:</p>\n<ul>\n<li><a href=\"http://dx.doi.org/10.1073/pnas.1613231114\">Koenig et al. (2017)</a>&nbsp;- Anti-VEGF antibody deep mutational scanning</li>\n<li><a href=\"https://www.biorxiv.org/content/10.1101/2023.01.08.523187v4\">Shanehsazzadeh et al. (2023)</a>&nbsp;- Trastuzumab binding data from generative models</li>\n<li><a href=\"https://www.nature.com/articles/s41467-024-48072-z\">Petersen et al. (2024)</a>&nbsp;- MAGMA-seq data (2 antibody systems)</li>\n<li><a href=\"https://www.pnas.org/doi/abs/10.1073/pnas.2412787122\">Kirby et al. (2025)</a>&nbsp;- MAGMA-seq data (4 antibody systems, SARS-CoV-2)</li>\n</ul>\n<p dir=\"auto\"><strong>Note</strong>: the first two data sets are from <a href=\"https://www.biorxiv.org/content/10.1101/2024.01.13.575504v1\">FLAb</a>; data is from commit <a href=\"https://github.com/Graylab/FLAb/tree/67738eea4841a1777b73609d56ddfa39de8d7360\">67738ee</a> (April 17, 2024). The FLAb repository has continued to receive updates; we use this specific commit for reproducibility.</p>\n<p dir=\"auto\"><strong>Training datasets</strong>:</p>\n<ul>\n<li><a href=\"http://dx.doi.org/10.1016/j.isci.2021.103668\">Tang et al. (2022)</a>&nbsp;- DeepSHM heavy chain sequences</li>\n<li><a href=\"https://www.nature.com/articles/s41586-022-05371-z\">Jaffe et al. (2022)</a> - Paired heavy and light chain sequences</li>\n<li><a href=\"https://www.biorxiv.org/content/10.1101/2025.05.28.656470v1.abstract\">Engelbrecht et al. (2025)</a>&nbsp;- Heavy and light chain sequences (kappa and lambda)</li>\n<li><a href=\"https://www.nature.com/articles/s41467-023-40070-x\">Rodriguez et al. (2023)</a> - RACE-seq data for perplexity analysis</li>\n</ul>", "access_right": "open", "creators": [{"name": "Matsen IV, Frederick", "affiliation": "Fred Hutch Cancer Center", "orcid": "0000-0003-0607-6025"}, {"name": "Sung, Kevin", "affiliation": null, "orcid": "0000-0002-7289-845X"}, {"name": "Johnson, Mackenzie M.", "affiliation": "Fred Hutch Cancer Center", "orcid": "0000-0002-3915-2023"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "17322890"}}]}}, "title": "Reprocessed data for training and benchmarking Deep Amino acid Selection Models", "links": {"self": "https://zenodo.org/api/records/17322891", "self_html": "https://zenodo.org/records/17322891", "preview_html": "https://zenodo.org/records/17322891?preview=1", "doi": "https://doi.org/10.5281/zenodo.17322891", "self_doi": "https://doi.org/10.5281/zenodo.17322891", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17322891", "reserve_doi": "https://zenodo.org/api/records/17322891/draft/pids/doi", "parent": "https://zenodo.org/api/records/17322890", "parent_html": "https://zenodo.org/records/17322890", "parent_doi": "https://doi.org/10.5281/zenodo.17322890", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17322890", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:17322891/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:17322891/sequence/default", "files": "https://zenodo.org/api/records/17322891/files", "media_files": "https://zenodo.org/api/records/17322891/media-files", "archive": "https://zenodo.org/api/records/17322891/files-archive", "archive_media": "https://zenodo.org/api/records/17322891/media-files-archive", "latest": "https://zenodo.org/api/records/17322891/versions/latest", "latest_html": "https://zenodo.org/records/17322891/latest", "versions": "https://zenodo.org/api/records/17322891/versions", "draft": "https://zenodo.org/api/records/17322891/draft", "access_links": "https://zenodo.org/api/records/17322891/access/links", "access_grants": "https://zenodo.org/api/records/17322891/access/grants", "access_users": "https://zenodo.org/api/records/17322891/access/users", "access_request": "https://zenodo.org/api/records/17322891/access/request", "access": "https://zenodo.org/api/records/17322891/access", "communities": "https://zenodo.org/api/records/17322891/communities", "communities-suggestions": "https://zenodo.org/api/records/17322891/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/17322891/request-deletion", "file_modification": "https://zenodo.org/api/records/17322891/file-modification", "quota_increase": "https://zenodo.org/api/records/17322891/quota-increase", "requests": "https://zenodo.org/api/records/17322891/requests"}, "updated": "2025-10-11T11:17:48.862578+00:00", "recid": "17322891", "revision": 4, "files": [{"id": "b62ffb68-f53e-4003-9c4c-4784c4c299c5", "key": "dasm-experiments-data.tar.gz", "size": 128695567, "checksum": "md5:df38a3488cc8d116bce1250ea18c351c", "links": {"self": "https://zenodo.org/api/records/17322891/files/dasm-experiments-data.tar.gz/content"}}], "swh": {}, "owners": [{"id": "10783"}], "status": "published", "stats": {"downloads": 51, "unique_downloads": 47, "views": 253, "unique_views": 233, "version_downloads": 51, "version_unique_downloads": 47, "version_unique_views": 233, "version_views": 253}, "state": "done", "submitted": true}