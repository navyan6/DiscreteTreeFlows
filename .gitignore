# Data — sequences stay off git; split metadata + formed/generated trees tracked
data/**
!data/**/
!data/README.md
!data/**/SPLIT_PROTOCOL.json
!data/**/*_group_*.csv
!data/**/group_*_rooted.nwk
!data/**/group_*_bl.json
# AA FASTA for formed trees (prefer NCBI/INSDC; avoid GISAID EPI_ISL dumps)
!data/**/group_*_anc_aa.fasta
# TreeSBM-generated Newick+FASTA
!data/generated/
!data/generated/**
# Regenerable caches / intermediates stay ignored even under un-ignored dirs
data/**/*_plm.pt
data/**/*_ref_rates.pt
data/**/group_*_aligned.fasta
data/**/group_*_clean.fasta
data/**/group_*_anc_nt.fasta
data/**/group_*_embeddings.pt

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# OS
.DS_Store

# Logs, checkpoints, embeddings (generated at runtime)
logs/
checkpoints/
*.pt

# Jupyter
.ipynb_checkpoints/

# CSV/zip source data (except split group CSVs under data/)
*.csv.zip
protein_sequences_table.csv
all_proteins.txt
proteins.txt

# External vendored at eval time (optional clone)
external/
